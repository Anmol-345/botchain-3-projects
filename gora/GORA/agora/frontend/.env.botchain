# BOT Chain — MAINNET (Chain ID 677)
# Real value. Run against Bohr testnet (`.env.bohr`) first.
#
# Fill VITE_VAULT_ADDRESS, VITE_ENS_REGISTRY, VITE_NAME_WRAPPER,
# VITE_PUBLIC_RESOLVER and VITE_DEPLOY_BLOCK after running:
#   forge script script/DeployENS.s.sol --rpc-url botchain --broadcast --slow
#   forge script script/SetupGora.s.sol --rpc-url botchain --broadcast --slow
#
# Launch with:  npm run dev:botchain   (or build:botchain)

VITE_CHAIN_ID=677
# You may list several RPCs separated by commas; the first is primary, the
# others take over automatically. Add a private RPC if you have one — public
# gateways can rate-limit eth_getLogs which the org chart relies on.
VITE_RPC_URL=https://rpc.botchain.ai

# GoraVault — fill after deployment
VITE_VAULT_ADDRESS=
VITE_PARENT_NAME=treasury.gora.eth
VITE_SEAT_COUNT=5
VITE_DEPLOY_BLOCK=0

# ENS stack (@ensdomains/ens-contracts 1.7.0), deployed by us on BOT Chain.
# Fill after DeployENS.s.sol prints them.
VITE_ENS_REGISTRY=
VITE_NAME_WRAPPER=
VITE_PUBLIC_RESOLVER=
