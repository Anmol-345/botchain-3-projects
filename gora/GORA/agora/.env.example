# ——— Contracts (Foundry deployment) ————————————————————————————
#
# GORA has no canonical ENS on BOT Chain, so you deploy the ENS stack yourself
# (script/DeployENS.s.sol) and then plug the printed addresses in here before
# running script/Deploy.s.sol or script/SetupGora.s.sol.

# ENS stack addresses — leave blank until DeployENS has run and printed them.
ENS_REGISTRY=
NAME_WRAPPER=

# namehash of the vault's parent name, e.g.:
#   cast namehash treasury.gora.eth
PARENT_NODE=
THRESHOLD=3

# ——— Networks —————————————————————————————————————————————————
# BOT Chain — see https://dev-docs.botchain.ai/docs/Developers/quick-guide/
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOHR_RPC_URL=https://rpc.bohr.life
ANVIL_RPC_URL=http://127.0.0.1:8545

# Deployer / setup key (do NOT commit).  For SetupGora.s.sol, this holds the
# root and treasury names during setup, then hands them to JULIE_ADDRESS.
SETUP_KEY=
JULIE_ADDRESS=

# Root label the setup script will register on our own .eth registrar:
#   ROOT_LABEL=gora   →   gora.eth   →   treasury.gora.eth   →   seat-N.treasury.gora.eth
ROOT_LABEL=gora

# ——— Frontend (frontend/.env.botchain or frontend/.env.bohr) ——————
# After deploying, copy these values into the matching frontend env file:
#
# VITE_CHAIN_ID=677                     # or 968 for Bohr testnet
# VITE_RPC_URL=https://rpc.botchain.ai  # or https://rpc.bohr.life
# VITE_VAULT_ADDRESS=<GoraVault address from Deploy.s.sol / SetupGora.s.sol>
# VITE_ENS_REGISTRY=<from DeployENS.s.sol>
# VITE_NAME_WRAPPER=<from DeployENS.s.sol>
# VITE_PUBLIC_RESOLVER=<from DeployENS.s.sol>
# VITE_PARENT_NAME=treasury.gora.eth
# VITE_SEAT_COUNT=5
# VITE_DEPLOY_BLOCK=<block number of the vault deployment, to bound the log scan>
